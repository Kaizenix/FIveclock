   "source": [
    "# Fiveclock · Evaluasi dan Ablasi 25 November 2026\n",
    "\n",
    "Notebook ini telah dijalankan pada **PKLot UFPR04 asli**, dengan 24 foto pengembangan dan 36 foto uji serta empat petak per foto. Tanggal pengujian terpisah dari tanggal kalibrasi dan pengembangan. Data dan hasil berada dalam paket Fiveclock_Evaluasi_25_November.zip.\n",
    "\n",
    "Di Colab, unggah notebook ini melalui File → Upload notebook, lalu jalankan semua sel. Saat diminta file, pilih ZIP paket tersebut. Citra dan manifest akan diekstrak di runtime.\n",
    ]
  },
  {
   "cell_type": "code",
   "id": "fiveclock-25-1",
   "metadata": {},
   "source": [
    "import importlib.util\n",
    "from pathlib import Path\n",
    "import subprocess\n",
    "import sys\n",
    "required = [\"numpy\", \"cv2\", \"sklearn\", \"matplotlib\", \"joblib\"]\n",
    "if any(importlib.util.find_spec(name) is None for name in required):\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\",\n",
    "        \"numpy==2.3.5\", \"opencv-python-headless==4.11.0.86\",\n",
    "        \"scikit-learn==1.8.0\", \"matplotlib==3.10.8\", \"joblib==1.5.3\"])\n",
    "import cv2\n",
    "if not hasattr(cv2, \"HOGDescriptor\"):\n",
    "    raise RuntimeError(\"Pasang opencv-python-headless==4.11.0.86, restart runtime, lalu jalankan ulang.\")"
   ],
   "execution_count": 1,
   "outputs": []
  },
  {
   "cell_type": "code",
   "id": "fiveclock-25-2",
   "metadata": {},
   "source": [
    "ROOT = Path.cwd()\n",
    "if not (ROOT / \"data/manifest.json\").is_file():\n",
    "    candidate = ROOT / \"fiveclock_25\"\n",
    "    if not (candidate / \"data/manifest.json\").is_file():\n",
    "        from google.colab import files\n",
    "        from io import BytesIO\n",
    "        import zipfile\n",
    "        uploaded = files.upload()\n",
    "        archives = [name for name in uploaded if name.lower().endswith(\".zip\")]\n",
    "        if len(archives) != 1:\n",
    "            raise ValueError(\"Unggah tepat satu ZIP Fiveclock_Evaluasi_25_November.zip.\")\n",
    "        with zipfile.ZipFile(BytesIO(uploaded[archives[0]])) as archive:\n",
    "            destination = ROOT.resolve()\n",
    "            for member in archive.infolist():\n",
    "                if not (destination / member.filename).resolve().is_relative_to(destination):\n",
    "                    raise ValueError(\"ZIP memiliki path di luar folder tujuan.\")\n",
    "            archive.extractall(destination)\n",
    "        candidate = ROOT / \"fiveclock_25\"\n",
    "    ROOT = candidate\n",
    "if not (ROOT / \"data/manifest.json\").is_file():\n",
    "    raise FileNotFoundError(\"Folder data/manifest.json belum tersedia.\")\n",
    "print(\"Folder proyek:\", ROOT)"
   ],
   "execution_count": 2,
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Folder proyek: /workspace/scratch/2e587f397ad3/work25/fiveclock_25\n"
     ]
    }
   ]
  },
  {
